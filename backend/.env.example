NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/smart_hr

# Auth
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000

# Public base URL (used to build Emergency QR Code links)
PUBLIC_BASE_URL=http://localhost:5000

# Optional: enable real AI answers (AI HR Companion, AI Scribe, Employer Branding)
# If left empty, the system falls back to built-in rule-based logic.
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
